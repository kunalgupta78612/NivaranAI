{
  "version": 2,
  "buildCommand": "cd nivaran-frontend && npm install && npm run build",
  "outputDirectory": "nivaran-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# ========================
# CivicFlow Backend
# Environment Variables
# ========================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/N

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

